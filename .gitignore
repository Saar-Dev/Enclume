# Dépendances
node_modules/

# Variables d'environnement
.env

# Build client
dist/
dist-ssr/

# Rapports de test
test-results/

# Logs
*.log
npm-debug.log*

# Runtime launcher (start.sh / stop.sh)
.dev-stack.pid

# Sauvegardes DB locales (pg_dump, jamais commit — trop volumineux, données de campagne)
/backups/

# Assets sources achetés en attente d'import (MinIO via Lot 0, PLANS/PLAN_DECALS.md) —
# jamais commit, trop volumineux ; la version qui compte vit en base une fois importée
/assets_source/

# Système
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
desktop.ini

# Claude Code — config personnelle / runtime
# (le partagé reste suivi : .claude/settings.json, .claude/rules/, .claude/hooks/)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Obsidian — config personnelle de l'éditeur (vault local), jamais partagée
.obsidian/
