{
  "permissions": {
    "deny": [
      "AskUserQuestion"
    ],
    "allow": [
      "Bash(node --check server/src/db/migrations/128_char_mutation_effects_view_int_cast.js)",
      "Bash(node --input-type=module -e ' *)",
      "WebFetch(domain:journal.stuffwithstuff.com)",
      "Bash(gh search *)",
      "Bash(curl -s \"https://api.github.com/search/code?q=flourish+repo:foundryvtt/pf2e\" -H \"Accept: application/vnd.github+json\")",
      "WebFetch(domain:grep.app)",
      "WebFetch(domain:waymondo.com)",
      "WebFetch(domain:sourcegraph.com)",
      "Bash(curl -s http://localhost:3001/api/health/detailed)",
      "Bash(node -e ' *)",
      "Bash(grep -c \"DATABASE_URL\" server/.env)",
      "Bash(grep -rn \"dotenv\" server/src/db/knex.js server/src/index.js server/knexfile.cjs)",
      "Bash(node --check server/src/services/vaultService.js)",
      "Bash(node --check server/src/routes/vault.js)",
      "Bash(curl -s -i -X POST http://localhost:3001/api/char-sheet/__TRACKED_VAR__/clone-to-vault -H 'Cookie: token=__TRACKED_VAR__' --max-time 10)",
      "Bash(curl -s -i http://localhost:3001/api/char-sheet/__TRACKED_VAR__ -H 'Cookie: token=__TRACKED_VAR__' --max-time 10)",
      "Bash(curl -s -X POST http://localhost:3001/api/char-sheet/__TRACKED_VAR__/clone-to-vault -H 'Cookie: token=__CMDSUB_OUTPUT__' --max-time 10)",
      "Bash(curl -s http://localhost:3001/api/vault/characters -H 'Cookie: token=__CMDSUB_OUTPUT__' --max-time 10)",
      "Bash(curl -s http://localhost:3001/api/vault/characters/__TRACKED_VAR__ -H 'Cookie: token=__CMDSUB_OUTPUT__' --max-time 10)",
      "Bash(grep -E '^[0-9]+$')",
      "Bash(curl -s -w '\\\\nSTATUS:%{http_code}\\\\n' -X POST http://localhost:3001/api/char-sheet/__TRACKED_VAR__/clone-to-vault -H 'Cookie: token=__CMDSUB_OUTPUT__' --max-time 10)",
      "Bash(curl -s -w \"\\\\nSTATUS:%{http_code}\\\\n\" \"http://localhost:3001/api/vault/characters\" --max-time 10)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-git-push.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
