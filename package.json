{
  "scripts": {
    "dev": "concurrently -k -i -n server,client -c blue,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "test": "node --test \"shared/**/*.test.mjs\" \"client/src/**/*.test.mjs\" \"server/src/**/*.test.mjs\"",
    "test:world": "node --test shared/world/*.test.mjs server/src/services/*.test.mjs",
    "test:server-config": "node --test server/src/lib/clientOrigins.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:remote": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run-remote.ps1"
  },
  "dependencies": {
    "csv-parse": "^6.2.1",
    "csv-parser": "^3.2.0",
    "fast-voxel-raycast": "^0.1.1",
    "image-size": "^2.0.2",
    "polygon-clipping": "^0.15.7",
    "socket.io-client": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^10.0.5"
  }
}
